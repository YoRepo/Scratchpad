[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
speaker = "Brother Anselm"
lines = PackedStringArray("Well met, sir knight. The margins of this meadow crawl with strange beasts of late.", "A snail the size of a hound sits on the road east. The scribes drew it, and so it is.", "Mind the ladders and the old rope by the ridge. The cloister gate lies past the far hill.")
