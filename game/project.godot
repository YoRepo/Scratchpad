; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scratchpad Side-Scroller"
config/version="0.2.0"
run/main_scene="res://src/game/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputActions="*res://src/core/input_actions.gd"
GameEvents="*res://src/core/game_events.gd"
DeviceInfo="*res://src/core/device_info.gd"
DebugBridge="*res://src/core/debug_bridge.gd"
DialogueRunner="*res://src/dialogue/dialogue_runner.gd"
ItemCatalog="*res://src/items/item_catalog.gd"
Inventory="*res://src/items/inventory.gd"
QuestLog="*res://src/quests/quest_log.gd"

[editor]

; Export-time text-to-binary conversion silently drops PackedStringArray exports
; from script resources (seen in 4.7.2 with content/dialogue/*.tres), so it stays off.
export/convert_text_resources_to_binary=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world_solid"
2d_physics/layer_2="world_platform"
2d_physics/layer_3="climbable"
2d_physics/layer_4="interactable"
2d_physics/layer_5="player"
2d_physics/layer_6="hurtbox"
2d_physics/layer_7="player_hurtbox"
2d_physics/layer_8="mob"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
